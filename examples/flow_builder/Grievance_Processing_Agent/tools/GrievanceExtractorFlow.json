                "input_schema": {
                    "type": "object",
                    "required": [
                        "hours_text"
                    ],
                    "properties": {
                        "hours_text": {
                            "type": "string",
                            "title": "Hours Text",
                            "description": "Text containing hours (e.g., \"10.5, 11.0, 9.0\")"
                        },
                        "grievance_type": {
                            "type": "string",
                            "title": "Grievance Type",
                            "default": "standard",
                            "description": "Type of grievance (e.g., \"XHN - Excessive Hours\")"
                        }
                    }
                },
                "output_schema": {
                    "type": "object",
                    "properties": {
                        "total_hours": {
                            "type": "string",
                            "title": "Total Hours",
                            "default": "0",
                            "description": "Total calculated violation hours"
                        },
                        "calculation_method": {
                            "type": "string",
                            "title": "Calculation Method",
                            "default": "standard",
                            "description": "Method used for calculation"
                        }
                    }
                },
                "error_handler_config": {
                    "max_retries": 0,
                    "error_message": "Something went wrong while running 'Calculate Violation Hours (Demo)'",
                    "retry_interval": 1000
                }
            },
